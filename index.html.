
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>MY APP</title>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  background: #10131c;
  color: white;
  font-family: -apple-system, sans-serif;
  padding: 55px 22px 25px;
}

h1 {
  font-size: 34px;
  margin-bottom: 8px;
}

.subtitle {
  color: #929bad;
  margin-bottom: 35px;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

button {
  border: 0;
  border-radius: 23px;
  padding: 23px 15px;
  min-height: 145px;
  text-align: left;
  color: white;
  font-size: 18px;
  font-weight: 700;
  background: #202a3b;
  transition: transform .15s;
}

button:active {
  transform: scale(.96);
}

button span {
  display: block;
  font-size: 36px;
  margin-bottom: 18px;
}

button small {
  display: block;
  color: #b7c1d1;
  font-size: 12px;
  font-weight: 400;
  margin-top: 7px;
}

.place { background: #263b59; }
.fridge { background: #25483c; }
.qr { background: #493b60; }
.cancel { background: #49333a; }

#result {
  margin-top: 25px;
  padding: 17px;
  border-radius: 17px;
  background: #202a3b;
  color: #d5dbea;
  display: none;
  overflow-wrap: anywhere;
}

footer {
  text-align: center;
  color: #667085;
  margin-top: 40px;
  font-size: 12px;
}
</style>
</head>

<body>

<h1>MY APP</h1>
<div class="subtitle">Твоё личное приложение</div>

<div class="grid">

<button class="place" onclick="getPlace()">
<span>📍</span>
Место
<small>Моё местоположение</small>
</button>

<button class="fridge" onclick="fridge()">
<span>🧊</span>
Холодильник
<small>Мои продукты</small>
</button>

<button class="qr" onclick="scanQR()">
<span>▦</span>
QR-код
<small>Сканирование</small>
</button>

<button class="cancel" onclick="cancelApp()">
<span>✕</span>
Отмена
<small>Закрыть окно</small>
</button>

</div>

<div id="result"></div>

<footer>MY APP · PERSONAL CONTROL</footer>

<script>
function show(message) {
  const box = document.getElementById("result");
  box.style.display = "block";
  box.textContent = message;
}

function getPlace() {
  if (!navigator.geolocation) {
    show("Местоположение не поддерживается.");
    return;
  }

  show("Получаем местоположение...");

  navigator.geolocation.getCurrentPosition(
    p => show(
      "Широта: " + p.coords.latitude +
      "\nДолгота: " + p.coords.longitude
    ),
    () => show("Не удалось получить местоположение.")
  );
}

function fridge() {
  const food = prompt("Напиши продукты в холодильнике:");
  if (food) show("Твои продукты:\n" + food);
}

function scanQR() {
  show("Для сканирования QR-кода потребуется подключить камеру через отдельный сканер или Команды iPhone.");
}

function cancelApp() {
  show("Приложение закрыто. Можно вернуться на главный экран.");
}
</script>

</body>
</html>
